# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Get a free PostgreSQL connection string from https://neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Pusher Channels (Real-time) ───────────────────────────────────────────────
# Create a free Channels app at https://pusher.com → Dashboard → Create app
# Server-side keys (never exposed to browser)
PUSHER_APP_ID="your-app-id"
PUSHER_KEY="your-key"
PUSHER_SECRET="your-secret"
PUSHER_CLUSTER="ap2"

# Client-side keys (prefixed NEXT_PUBLIC_ so Next.js exposes them to browser)
NEXT_PUBLIC_PUSHER_KEY="your-key"        # same as PUSHER_KEY
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"          # same as PUSHER_CLUSTER

# ── App URL ───────────────────────────────────────────────────────────────────
# Set this to your Vercel deployment URL after first deploy
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
